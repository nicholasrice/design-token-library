{
    "$description": "Exercises the DTCG 2025.10 color module: every color space, alpha, hex and none.",
    "color": {
        "$type": "color",
        "srgb": {
            "$value": {
                "colorSpace": "srgb",
                "components": [1, 0, 1],
                "alpha": 1,
                "hex": "#ff00ff"
            }
        },
        "translucent": {
            "$value": {
                "colorSpace": "srgb",
                "components": [0, 0, 0],
                "alpha": 0.5,
                "hex": "#000000"
            }
        },
        "srgb-linear": {
            "$value": {
                "colorSpace": "srgb-linear",
                "components": [0.2, 0.4, 0.6]
            }
        },
        "hsl": {
            "$value": { "colorSpace": "hsl", "components": [210, 50, 40] }
        },
        "hsl-none": {
            "$value": { "colorSpace": "hsl", "components": ["none", 0, 100] },
            "$description": "A hue of none is not the same as a hue of 0 when colors are mixed."
        },
        "hwb": {
            "$value": { "colorSpace": "hwb", "components": [120, 10, 20] }
        },
        "lab": {
            "$value": { "colorSpace": "lab", "components": [50, -40, 60] }
        },
        "lch": {
            "$value": { "colorSpace": "lch", "components": [50, 80, 359.9] }
        },
        "oklab": {
            "$value": { "colorSpace": "oklab", "components": [0.6, -0.1, 0.1] }
        },
        "oklch": {
            "$value": { "colorSpace": "oklch", "components": [0.7, 0.15, 200] }
        },
        "display-p3": {
            "$value": { "colorSpace": "display-p3", "components": [0, 1, 0] }
        },
        "a98-rgb": {
            "$value": { "colorSpace": "a98-rgb", "components": [0.1, 0.2, 0.3] }
        },
        "prophoto-rgb": {
            "$value": {
                "colorSpace": "prophoto-rgb",
                "components": [0.3, 0.2, 0.1]
            }
        },
        "rec2020": {
            "$value": { "colorSpace": "rec2020", "components": [0.5, 0.5, 0.5] }
        },
        "xyz-d65": {
            "$value": { "colorSpace": "xyz-d65", "components": [0.3, 0.4, 0.5] }
        },
        "xyz-d50": {
            "$value": { "colorSpace": "xyz-d50", "components": [0.3, 0.4, 0.5] }
        },
        "channels": {
            "$description": "Components and alpha may reference number tokens, with a JSON Pointer.",
            "red": { "$type": "number", "$value": 0.25 },
            "opacity": { "$type": "number", "$value": 0.75 },
            "mixed": {
                "$value": {
                    "colorSpace": "srgb",
                    "components": [
                        { "$ref": "#/color/channels/red/$value" },
                        0.5,
                        0.5
                    ],
                    "alpha": { "$ref": "#/color/channels/opacity/$value" }
                }
            }
        }
    }
}
