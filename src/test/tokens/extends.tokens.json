{
    "$description": "Exercises $extends (both reference forms, chaining, deep merge) and $ref JSON Pointers.",
    "base": {
        "$type": "color",
        "$description": "The group everything else extends.",
        "text": {
            "$value": { "colorSpace": "srgb", "components": [0, 0, 0] }
        },
        "background": {
            "$value": { "colorSpace": "srgb", "components": [1, 1, 1] }
        },
        "accent": {
            "light": {
                "$value": { "colorSpace": "srgb", "components": [0.6, 0.8, 1] }
            },
            "dark": {
                "$value": { "colorSpace": "srgb", "components": [0, 0.2, 0.6] }
            }
        }
    },
    "dark": {
        "$extends": "{base}",
        "$description": "Dark mode: replaces a token and merges into a nested group.",
        "background": {
            "$value": { "colorSpace": "srgb", "components": [0, 0, 0] }
        },
        "text": {
            "$value": { "colorSpace": "srgb", "components": [1, 1, 1] }
        },
        "accent": {
            "dark": {
                "$value": { "colorSpace": "srgb", "components": [0, 0.1, 0.3] }
            },
            "mid": {
                "$value": {
                    "colorSpace": "srgb",
                    "components": [0.2, 0.4, 0.8]
                }
            }
        }
    },
    "dim": {
        "$extends": { "$ref": "#/dark" },
        "$description": "Extends a group that itself extends, using the $ref form.",
        "text": {
            "$value": { "colorSpace": "srgb", "components": [0.8, 0.8, 0.8] }
        }
    },
    "aliases": {
        "$description": "An alias in an extended group is not rewritten: it still names the original token.",
        "$extends": "{base}",
        "echo": { "$type": "color", "$value": "{base.text}" }
    },
    "pointers": {
        "$description": "JSON Pointers: to a $value (an alias), into a value (a copy), and inside $extensions (left alone).",
        "link": {
            "$type": "color",
            "$value": { "$ref": "#/base/text/$value" },
            "$description": "Becomes an alias of base.text, so it follows changes to it."
        },
        "channel": {
            "$type": "number",
            "$value": { "$ref": "#/base/accent/light/$value/components/1" },
            "$description": "A copy of one component."
        },
        "stretched": {
            "$type": "dimension",
            "$value": {
                "value": 8,
                "unit": { "$ref": "#/pointers/unit/$value/unit" }
            }
        },
        "unit": {
            "$type": "dimension",
            "$value": { "value": 1, "unit": "rem" }
        },
        "escaped": {
            "$type": "number",
            "$value": { "$ref": "#/names~1with~1slashes/inner~0tilde/$value" }
        },
        "vendor": {
            "$type": "number",
            "$value": 1,
            "$extensions": {
                "com.example": { "$ref": "kept as the vendor wrote it" }
            }
        }
    },
    "names/with/slashes": {
        "inner~tilde": { "$type": "number", "$value": 42 }
    }
}
